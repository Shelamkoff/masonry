{
  "name": "@shelamkoff/masonry",
  "version": "1.0.0",
  "description": "Framework-agnostic responsive masonry grid with row and column modes, column spans, media-aware measurement, transitions, and infinite loading",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./styles.css": "./dist/styles/masonry.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "demo": "node scripts/dev-server.mjs /demo.html",
    "test": "node --test test/*.test.js",
    "test:types": "npm run build && node scripts/check-types.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:browser": "node --test browser-tests/*.test.mjs",
    "verify": "npm test && npm run test:types && npm run test:package && npm run test:browser",
    "prepublishOnly": "npm run verify",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@shelamkoff/event-bus": "^1.0.0",
    "@shelamkoff/infinite-scroll": "^1.0.1"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "javascript",
    "masonry",
    "masonry-layout",
    "grid",
    "responsive-layout",
    "waterfall-grid",
    "infinite-scroll",
    "image-grid",
    "column-span",
    "vanilla-js",
    "framework-agnostic",
    "esm",
    "typescript"
  ],
  "author": "Shelamkoff",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shelamkoff/masonry.git"
  },
  "homepage": "https://shelamkoff.github.io/masonry/",
  "bugs": {
    "url": "https://github.com/Shelamkoff/masonry/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
